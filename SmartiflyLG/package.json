{
  "name": "smartifly-lg",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start:legacy": "npm run build && vite preview --host 0.0.0.0",
    "build": "vite build",
    "build:chrome38": "set CHROME38_COMPAT=true&& vite build",
    "probe:stream": "node scripts/probe-stream.mjs",
    "probe:switch": "node scripts/probe-live-switch.mjs",
    "webos:stage": "npm run build",
    "webos:package": "npm run webos:stage && ares-package --no-minify dist",
    "webos:package:hosted": "ares-package --no-minify hosted",
    "webos:install": "ares-install com.smartifly.lg_0.1.0_all.ipk",
    "webos:launch": "ares-launch com.smartifly.lg"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "hls.js": "^1.6.16",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "shaka-player": "^4.16.3",
    "vite": "^7.2.6",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "abortcontroller-polyfill": "^1.7.8",
    "core-js-bundle": "^3.49.0",
    "typescript": "^5.9.3",
    "whatwg-fetch": "^3.6.20"
  }
}
