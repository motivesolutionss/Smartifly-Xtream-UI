# ============================================================
# SMARTIFLY XTREAM UI - ENTERPRISE BACKEND CONFIG (LOCAL)
# ============================================================

# 1) DATABASE
DATABASE_URL="mysql://root:CHANGE_ME_ENCODED_PASSWORD@localhost:3306/smartifly_xtream_db"

# 2) AUTHENTICATION
JWT_SECRET="CHANGE_ME_LONG_RANDOM_JWT_SECRET"
JWT_ACCESS_SECRET="CHANGE_ME_LONG_RANDOM_ACCESS_SECRET"
JWT_REFRESH_SECRET="CHANGE_ME_LONG_RANDOM_REFRESH_SECRET"
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN_DAYS=30

# 3) LICENSE SETTINGS
LICENSE_KEY_MODE=HMAC
LICENSE_KEY_SECRET="CHANGE_ME_LICENSE_SECRET"
LICENSE_KEY_PREFIX="ST"
LICENSE_KEY_SIZE=20

# 4) URLs & CORS
PORT=5000
NODE_ENV=development
FRONTEND_URL="https://xtreamui.duckdns.org"
CORS_ORIGINS="http://localhost:3000,http://localhost:3002,http://localhost:5173,https://xtreamui.duckdns.org"

# 5) EMAIL (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS="CHANGE_ME_SMTP_PASSWORD"

# 6) SYSTEM
CONFIG_ENCRYPTION_KEY="CHANGE_ME_CONFIG_KEY"

# Intelligence & Enrichment
TMDB_API_KEY=CHANGE_ME_TMDB_API_KEY
