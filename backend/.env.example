# Environment
NODE_ENV=development
PORT=3001

# Database (MySQL/MariaDB - for cPanel hosting)
# Format: mysql://USERNAME:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://xtream_user:change_me@127.0.0.1:3306/xtream_db"

# JWT Secret (MUST be at least 32 characters for security!)
JWT_SECRET=replace_with_at_least_64_random_characters
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Firebase (for push notifications)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com

# Admin Setup (initial admin credentials)
ADMIN_EMAIL=admin@smartifly.com
ADMIN_PASSWORD=change_me_strong_admin_password

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:3001

# Email (required)
BREVO_API_KEY=replace_me
SMTP_FROM=noreply@example.com
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=replace_me
SMTP_PASS=replace_me
SMTP_SECURE=false

# Frontend base URL for email links
FRONTEND_URL=http://localhost:3002
